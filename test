local function activateButton(index)
    local ok, err = pcall(buttonActions[index])
    draw()
end

local function runCheck()
    local frontInput = peripheral.call("redstone_relay_16", "getAnalogInput", "front")
    local backInput = peripheral.call("redstone_relay_16", "getAnalogInput", "back")
    if frontInput == 15 and backInput == 0 then
        buttonColors[9] = colors.red
        peripheral.call("redstone_relay_14", "setAnalogOutput", "top", 0)
        draw()
    end
end

local checkTimer = os.startTimer(1)

draw()

while true do
    local event, eventId, x, y = os.pullEvent()

    if event == "timer" and eventId == checkTimer then
        runCheck()
        checkTimer = os.startTimer(1)
    elseif event == "term_resize" then
        draw()
    elseif event == "mouse_click" or event == "monitor_touch" then
        local width, height = term.getSize()
        local buttonHeight = math.max(1, height - 1)

        if x >= 1 and x <= width and y >= 1 and y <= buttonHeight then
            local column = math.min(2, math.floor((x - 1) * 3 / width))
            local row = math.min(2, math.floor((y - 1) * 3 / buttonHeight))
            activateButton(row * 3 + column + 1)
            os.cancelTimer(checkTimer)
            checkTimer = os.startTimer(1)
        end
    end

end
