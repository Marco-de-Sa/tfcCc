-- Touch GUI for the Create: Gadgets & Gizmos Advanced Navigation Table.
-- Connect an Advanced Monitor and the table to this computer, then run main.

local args = { ... }

local function findPeripheral(wantedName, wantedType, isSuitable)
    if wantedName then
        if not peripheral.isPresent(wantedName) then
            error("Peripheral not found: " .. wantedName)
        end
        if peripheral.getType(wantedName) ~= wantedType then
            error(wantedName .. " is not a " .. wantedType .. " peripheral")
        end
        local wrapped = peripheral.wrap(wantedName)
        if not isSuitable(wrapped) then
            error(wantedName .. " does not support the required methods")
        end
        return wrapped, wantedName
    end

    for _, name in ipairs(peripheral.getNames()) do
        if peripheral.getType(name) == wantedType then
            local wrapped = peripheral.wrap(name)
            if isSuitable(wrapped) then
                return wrapped, name
            end
        end
    end
    return nil, nil
end

local function isAdvancedMonitor(monitor)
    return monitor
        and type(monitor.getSize) == "function"
        and type(monitor.isColor) == "function"
        and monitor.isColor()
        and type(monitor.setCursorPos) == "function"
        and type(monitor.write) == "function"
end

local function isNavigationTable(nav)
    return nav
        and type(nav.listSlots) == "function"
        and type(nav.getSelectedSlot) == "function"
        and type(nav.setSelectedSlot) == "function"
end

local monitor, monitorName = findPeripheral(args[1], "monitor", isAdvancedMonitor)
if not monitor then
    error("No Advanced Monitor found. Connect one or pass its peripheral name.")
end

local nav = findPeripheral(args[2], "navigation_table", isNavigationTable)
if not nav then
    error("No Advanced Navigation Table found. Connect one or pass its peripheral name.")
end

local regions = {}

local function centerText(y, text, foreground, background)
    local width = monitor.getSize()
    text = tostring(text or "")
    if #text > width then
        text = text:sub(1, math.max(1, width - 1)) .. ">"
    end
    monitor.setCursorPos(math.max(1, math.floor((width - #text) / 2) + 1), y)
    monitor.setTextColor(foreground)
    monitor.setBackgroundColor(background)
    monitor.write(text)
end

local function drawButton(x, y, width, label, action)
    local screenWidth = monitor.getSize()
    width = math.min(width, screenWidth - x + 1)
    if width < 1 then
        return
    end
    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(colors.blue)
    monitor.setTextColor(colors.white)
    monitor.write(label .. string.rep(" ", math.max(0, width - #label)))
    regions[#regions + 1] = {
        left = x,
        right = x + width - 1,
        row = y,
        action = action,
    }
end

local function getSlots()
    local slots = nav.listSlots()
    if type(slots) ~= "table" then
        error("Navigation table returned an invalid slot list")
    end
    for i, slot in ipairs(slots) do
        if type(slot) ~= "table" or tonumber(slot.slot) == nil then
            error("Navigation table returned an invalid slot at position " .. i)
        end
    end
    return slots
end

local function selectedSlot(selected, slots)
    selected = tonumber(selected)
    if selected then
        for i, slot in ipairs(slots) do
            if tonumber(slot.slot) == selected then
                return i
            end
        end
    end
    return #slots > 0 and 1 or nil
end

local function displayName(slot)
    if not slot then
        return "No slots available"
    end
    if slot.filled == false then
        return "Empty slot"
    end
    if type(slot.name) == "string" and slot.name ~= "" then
        return slot.name
    end
    if type(nav.getMapName) == "function" then
        local name = nav.getMapName(tonumber(slot.slot))
        if type(name) == "string" and name ~= "" then
            return name
        end
    end
    return "Unnamed item"
end

local function draw()
    local width, height = monitor.getSize()
    local slots = getSlots()
    local index = selectedSlot(nav.getSelectedSlot(), slots)
    local current = index and slots[index] or nil

    regions = {}
    monitor.setBackgroundColor(colors.black)
    monitor.setTextColor(colors.white)
    monitor.clear()

    centerText(1, "NAVIGATION TABLE", colors.cyan, colors.black)
    centerText(3, "Selected item", colors.lightGray, colors.black)
    centerText(4, displayName(current), colors.white, colors.black)

    if current then
        centerText(6, "Slot " .. tostring(current.slot) .. " of " .. #slots,
            colors.yellow, colors.black)
    else
        centerText(6, "No slots detected", colors.yellow, colors.black)
    end

    if height >= 8 then
        local buttonY = height - 1
        local buttonWidth = math.floor(width / 2)
        drawButton(1, buttonY, buttonWidth, "< PREV", "previous")
        drawButton(buttonWidth + 1, buttonY, width - buttonWidth, "NEXT >", "next")
    end
end

local function changeSlot(direction)
    local slots = getSlots()
    if #slots == 0 then
        return
    end

    local index = selectedSlot(nav.getSelectedSlot(), slots) or 1
    index = ((index - 1 + direction) % #slots) + 1
    nav.setSelectedSlot(tonumber(slots[index].slot))
end

draw()
local timer = os.startTimer(1)

while true do
    local event, side, x, y = os.pullEvent()
    if event == "monitor_touch" and side == monitorName then
        for _, region in ipairs(regions) do
            if y == region.row and x >= region.left and x <= region.right then
                if region.action == "previous" then
                    changeSlot(-1)
                elseif region.action == "next" then
                    changeSlot(1)
                end
                draw()
                break
            end
        end
    elseif event == "timer" and side == timer then
        draw()
        timer = os.startTimer(1)
    elseif event == "monitor_resize" and side == monitorName then
        draw()
    end
end
