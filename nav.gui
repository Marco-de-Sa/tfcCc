-- Touch GUI for the Create: Gadgets & Gizmos Advanced Navigation Table.
-- Connect an Advanced Monitor and the table to this computer, then run main.

local args = { ... }

local function methodsFor(name)
    if peripheral.getMethods then
        return peripheral.getMethods(name)
    end
    return {}
end

local function diagnostic()
    local devices = {}
    for _, name in ipairs(peripheral.getNames()) do
        local kind = peripheral.getType(name)
        local methods = methodsFor(name)
        devices[#devices + 1] = name .. " (" .. tostring(kind) .. "): "
            .. table.concat(methods, ", ")
    end
    if #devices == 0 then
        return "No peripherals are connected."
    end
    return table.concat(devices, "\n")
end

local function findPeripheral(wantedName, isSuitable, label)
    if wantedName then
        if not peripheral.isPresent(wantedName) then
            error("Peripheral not found: " .. wantedName)
        end
        local wrapped = peripheral.wrap(wantedName)
        if not isSuitable(wrapped) then
            error(wantedName .. " is not a supported " .. label .. " peripheral.\n"
                .. diagnostic())
        end
        return wrapped, wantedName
    end

    for _, name in ipairs(peripheral.getNames()) do
        local wrapped = peripheral.wrap(name)
        if isSuitable(wrapped, name) then
            return wrapped, name
        end
    end
    return nil, nil
end

local function isAdvancedMonitor(monitor)
    return monitor
        and type(monitor.getSize) == "function"
        and type(monitor.isColor) == "function"
        and monitor.isColor()
        and type(monitor.setCursorPos) == "function"
        and type(monitor.write) == "function"
end

local function isNavigationTable(nav, name)
    if not nav then
        return false
    end
    local canList = type(nav.listSlots) == "function"
        or (type(nav.getSlotCount) == "function" and type(nav.getSlot) == "function")
    local canSelect = type(nav.setSelectedSlot) == "function"
        or (type(nav.nextSlot) == "function" and type(nav.previousSlot) == "function")
    local peripheralType = name and peripheral.getType(name)
    local hasNavigationType = type(peripheralType) == "string"
        and peripheralType:lower():find("navigation", 1, true) ~= nil
    return (canList and canSelect) or hasNavigationType
end

local requestedMonitor, requestedNav
for _, name in ipairs(args) do
    if peripheral.isPresent(name) then
        local wrapped = peripheral.wrap(name)
        if isAdvancedMonitor(wrapped) then
            requestedMonitor = name
        elseif isNavigationTable(wrapped, name) then
            requestedNav = name
        else
            error("Peripheral " .. name .. " is neither a supported monitor nor a navigation table.\n"
                .. diagnostic())
        end
    end
end

local monitor, monitorName = findPeripheral(requestedMonitor, isAdvancedMonitor, "Advanced Monitor")
if not monitor then
    error("No Advanced Monitor found. Connect one or pass its peripheral name.\n"
        .. diagnostic())
end

local nav = findPeripheral(requestedNav, isNavigationTable, "Advanced Navigation Table")
if not nav then
    error("No supported Advanced Navigation Table found. This version needs "
        .. "listSlots() and setSelectedSlot(), or getSlotCount()/getSlot() and "
        .. "nextSlot()/previousSlot().\n" .. diagnostic())
end
if not isNavigationTable(nav) then
    error("The connected navigation table does not expose a supported slot API.\n"
        .. diagnostic())
end

local regions = {}

local function centerText(y, text, foreground, background)
    local width = monitor.getSize()
    text = tostring(text or "")
    if #text > width then
        text = text:sub(1, math.max(1, width - 1)) .. ">"
    end
    monitor.setCursorPos(math.max(1, math.floor((width - #text) / 2) + 1), y)
    monitor.setTextColor(foreground)
    monitor.setBackgroundColor(background)
    monitor.write(text)
end

local function drawButton(x, y, width, label, action)
    local screenWidth = monitor.getSize()
    width = math.min(width, screenWidth - x + 1)
    if width < 1 then
        return
    end
    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(colors.blue)
    monitor.setTextColor(colors.white)
    monitor.write(label .. string.rep(" ", math.max(0, width - #label)))
    regions[#regions + 1] = {
        left = x,
        right = x + width - 1,
        row = y,
        action = action,
    }
end

local function getSlots()
    local slots
    if type(nav.listSlots) == "function" then
        slots = nav.listSlots()
        if type(slots) ~= "table" then
            error("Navigation table returned an invalid slot list")
        end
    else
        slots = {}
        for i = 1, nav.getSlotCount() do
            slots[i] = nav.getSlot(i)
        end
    end
    for i, slot in ipairs(slots) do
        if type(slot) ~= "table" then
            error("Navigation table returned an invalid slot at position " .. i)
        end
        slot.slot = tonumber(slot.slot) or i
    end
    return slots
end

local function selectedSlot(selected, slots)
    selected = tonumber(selected)
    if selected then
        for i, slot in ipairs(slots) do
            if tonumber(slot.slot) == selected then
                return i
            end
        end
    end
    return #slots > 0 and 1 or nil
end

local function displayName(slot)
    if not slot then
        return "No slots available"
    end
    if slot.filled == false then
        return "Empty slot"
    end
    if type(slot.name) == "string" and slot.name ~= "" then
        return slot.name
    end
    if type(nav.getMapName) == "function" then
        local name = nav.getMapName(tonumber(slot.slot))
        if type(name) == "string" and name ~= "" then
            return name
        end
    end
    return "Unnamed item"
end

local function draw()
    local width, height = monitor.getSize()
    local slots = getSlots()
    local selected = type(nav.getSelectedSlot) == "function" and nav.getSelectedSlot() or nil
    local index = selectedSlot(selected, slots)
    local current = index and slots[index] or nil

    regions = {}
    monitor.setBackgroundColor(colors.black)
    monitor.setTextColor(colors.white)
    monitor.clear()

    centerText(1, "NAVIGATION TABLE", colors.cyan, colors.black)
    centerText(3, "Selected item", colors.lightGray, colors.black)
    centerText(4, displayName(current), colors.white, colors.black)

    if current then
        centerText(6, "Slot " .. tostring(current.slot) .. " of " .. #slots,
            colors.yellow, colors.black)
    else
        centerText(6, "No slots detected", colors.yellow, colors.black)
    end

    if height >= 8 then
        local buttonY = height - 1
        local buttonWidth = math.floor(width / 2)
        drawButton(1, buttonY, buttonWidth, "< PREV", "previous")
        drawButton(buttonWidth + 1, buttonY, width - buttonWidth, "NEXT >", "next")
    end
end

local function changeSlot(direction)
    local slots = getSlots()
    if #slots == 0 then
        return
    end

    local index = selectedSlot(
        type(nav.getSelectedSlot) == "function" and nav.getSelectedSlot() or nil,
        slots
    ) or 1
    index = ((index - 1 + direction) % #slots) + 1
    if type(nav.setSelectedSlot) == "function" then
        nav.setSelectedSlot(tonumber(slots[index].slot))
    elseif direction < 0 then
        nav.previousSlot()
    else
        nav.nextSlot()
    end
end

draw()
local timer = os.startTimer(1)

while true do
    local event, side, x, y = os.pullEvent()
    if event == "monitor_touch" and side == monitorName then
        for _, region in ipairs(regions) do
            if y == region.row and x >= region.left and x <= region.right then
                if region.action == "previous" then
                    changeSlot(-1)
                elseif region.action == "next" then
                    changeSlot(1)
                end
                draw()
                break
            end
        end
    elseif event == "timer" and side == timer then
        draw()
        timer = os.startTimer(1)
    elseif event == "monitor_resize" and side == monitorName then
        draw()
    end
end
